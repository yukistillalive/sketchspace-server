CLIENT_ORIGIN=http://localhost:8080,http://localhost:8081
# Signs login cookies and tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=3c7849f55f7918a4985a2c19368319f5040c81f99caeff51e52f7067371ed9bb
# Enables Google sign-in, the same as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=156752573172-u54s5eacpd04icgsjoq166c393psbtre.apps.googleusercontent.com

# --- Docker deployment ---
# Public hostname of the server. Caddy then serves HTTPS for it.
# Leave as :80 to serve plain HTTP (local testing).
SITE_ADDRESS=:80
# Host ports for Caddy (change only for local testing)
HTTP_PORT=80
HTTPS_PORT=443
# Host port to inspect the database on, this machine only (mongodb://localhost:27018)
MONGO_PORT=27018

# --- npm run dev (without Docker) ---
PORT=3000
MONGODB_URI=mongodb://localhost:27017/sketch-space
