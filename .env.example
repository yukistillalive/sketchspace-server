# Copy to .env and fill in. .env is never committed or built into an image.
# Never put real secrets in this file: it is committed.

# Where the frontend is served from: scheme and host only, no path, no trailing slash.
# Comma-separated for several.
CLIENT_ORIGIN=http://localhost:8080
# Signs login cookies and tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: enables Google sign-in
GOOGLE_CLIENT_ID=

# --- Docker deployment ---
# Public hostname of the server, e.g. 91-98-226-226.sslip.io. Caddy then serves HTTPS for it.
# Leave as :80 to serve plain HTTP (local testing).
SITE_ADDRESS=:80
# Host ports for Caddy (change only for local testing)
HTTP_PORT=80
HTTPS_PORT=443
# Host port to inspect the database on, this machine only (mongodb://localhost:27018)
MONGO_PORT=27018

# --- npm run dev (without Docker) ---
PORT=3000
MONGODB_URI=mongodb://localhost:27017/sketch-space
