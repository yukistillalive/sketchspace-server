# Where the frontend is served from, exactly as the browser shows it (comma-separated for several)
CLIENT_ORIGIN=http://localhost:8080, http://localhost:8081
# Signs login cookies. Generate one with: openssl rand -hex 32
JWT_SECRET=3c7849f55f7918a4985a2c19368319f5040c81f99caeff51e52f7067371ed9bb
# Port the server is reached on
PORT=3000
# Optional: enables Google sign-in
GOOGLE_CLIENT_ID=
# Docker only: host port to inspect the database on (mongodb://localhost:27018)
MONGO_PORT=27018

# Only for running without Docker (`npm run dev`); Docker uses its own MongoDB
MONGODB_URI=mongodb://localhost:27017/sketch-space
