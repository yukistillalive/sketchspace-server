{
  "name": "dh2643-seminar-express-mongodb-communication",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:socket": "tsx --test test/socket.test.ts",
    "test": "tsx --test --test-concurrency=1 test/socket.test.ts test/canvas.service.test.ts test/cors.test.ts test/ownership.test.ts",
    "test:service": "tsx --test test/canvas.service.test.ts",
    "test:unit": "JWT_SECRET=test-secret tsx --test test/auth.unit.test.ts",
    "test:auth": "tsx --test test/auth.test.ts",
    "test:cors": "tsx --test test/cors.test.ts",
    "test:ownership": "tsx --test test/ownership.test.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
